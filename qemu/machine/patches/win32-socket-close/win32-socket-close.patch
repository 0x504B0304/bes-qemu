+#ifdef CONFIG_WIN32
+static void test_io_channel_socket_close_handle(void)
+{
+    for (unsigned inherit = 0; inherit < 2; inherit++) {
+        int fd = socket(AF_INET, SOCK_STREAM, 0);
+        SOCKET raw = _get_osfhandle(fd);
+        DWORD before, after;
+
+        g_assert_cmpint(fd, >=, 0);
+        g_assert_true(SetHandleInformation((HANDLE)raw, HANDLE_FLAG_INHERIT,
+            inherit ? HANDLE_FLAG_INHERIT : 0));
+        g_assert_true(GetHandleInformation((HANDLE)raw, &before));
+        g_assert_false(before & HANDLE_FLAG_PROTECT_FROM_CLOSE);
+        /* Releasing the CRT descriptor must leave the socket available for
+         * closesocket(), with its original inheritance/protection flags. */
+        g_assert_cmpint(qemu_close_socket_osfhandle(fd), ==, 0);
+        g_assert_true(GetHandleInformation((HANDLE)raw, &after));
+        g_assert_cmpuint(after, ==, before);
+        g_assert_cmpint(closesocket(raw), ==, 0);
+        g_assert_false(GetHandleInformation((HANDLE)raw, &after));
+
+        /* The ordinary close wrapper must release both resources as well. */
+        fd = socket(AF_INET, SOCK_STREAM, 0);
+        g_assert_cmpint(fd, >=, 0);
+        raw = _get_osfhandle(fd);
+        g_assert_cmpint(close(fd), ==, 0);
+        g_assert_false(GetHandleInformation((HANDLE)raw, &after));
+    }
+}
+#endif
