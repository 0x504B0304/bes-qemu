+
+/* Keep the limit immutable once CPUs can use cached translation blocks. */
+static void tcg_get_max_insns_per_tb(Object *obj, Visitor *v,
+                                    const char *name, void *opaque,
+                                    Error **errp)
+{
+    TCGState *s = TCG_STATE(obj);
+    uint32_t value = s->max_insns_per_tb;
+
+    visit_type_uint32(v, name, &value, errp);
+}
+
+static void tcg_set_max_insns_per_tb(Object *obj, Visitor *v,
+                                    const char *name, void *opaque,
+                                    Error **errp)
+{
+    TCGState *s = TCG_STATE(obj);
+    uint32_t value;
+
+    if (!visit_type_uint32(v, name, &value, errp)) {
+        return;
+    }
+    if (s->initialized) {
+        error_setg(errp, "max-insns-per-tb cannot change after initialization");
+        return;
+    }
+    if (value < 1 || value > TCG_MAX_INSNS) {
+        error_setg(errp, "max-insns-per-tb must be in 1..%u", TCG_MAX_INSNS);
+        return;
+    }
+    s->max_insns_per_tb = value;
 }
 
