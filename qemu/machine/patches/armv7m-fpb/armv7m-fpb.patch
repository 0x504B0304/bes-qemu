+/* FPBv2 subset for the Mi Band Cortex-M33 probe. Eight instruction address
+ * comparators, KEY/ENABLE and full halfword address matching; no flash
+ * remapping, DWT, halting debugger, or secure debug authentication model. */
+static void nvic_fpb_update(NVICState *s)
+{
+    CPUARMState *env = &s->cpu->env;
+    unsigned i;
+
+    cpu_breakpoint_remove_all(CPU(s->cpu), BP_CPU);
+    memset(env->cpu_breakpoint, 0, sizeof(env->cpu_breakpoint));
+    if (!(s->fpb_ctrl & 1)) {
+        return;
+    }
+    for (i = 0; i < ARRAY_SIZE(s->fpb_comp); ++i) {
+        if (s->fpb_comp[i] & 1) {
+            cpu_breakpoint_insert(CPU(s->cpu), s->fpb_comp[i] & ~1u,
+                                  BP_CPU, &env->cpu_breakpoint[i]);
+        }
+    }
+}
+
+static MemTxResult nvic_fpb_read(void *opaque, hwaddr offset, uint64_t *data,
+                                 unsigned size, MemTxAttrs attrs)
+{
+    NVICState *s = opaque;
+    if (attrs.user) {
+        return MEMTX_ERROR;
+    }
+    *data = 0;
+    if (offset == 0) {
+        *data = 0x10000080u | (s->fpb_ctrl & 1);
+    } else if (offset >= 8 && offset < 40) {
+        *data = s->fpb_comp[(offset - 8) / 4];
+    }
+    return MEMTX_OK;
+}
+
+static MemTxResult nvic_fpb_write(void *opaque, hwaddr offset, uint64_t value,
+                                  unsigned size, MemTxAttrs attrs)
+{
+    NVICState *s = opaque;
+    if (attrs.user) {
+        return MEMTX_ERROR;
+    }
+    if (offset == 0 && (value & 2)) {
+        s->fpb_ctrl = value & 1;
+        nvic_fpb_update(s);
+    } else if (offset >= 8 && offset < 40) {
+        s->fpb_comp[(offset - 8) / 4] = value;
+        nvic_fpb_update(s);
+    }
+    return MEMTX_OK;
+}
+
+static const MemoryRegionOps nvic_fpb_ops = {
+    .read_with_attrs = nvic_fpb_read,
+    .write_with_attrs = nvic_fpb_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4, .unaligned = false },
+};
 
