+/* ARMv7-M FPBv2. The legacy bit-0 comparator encoding used by existing
+ * firmware is accepted in addition to the architectural REPLACE field.
+ * FPB breakpoints are kept in their own ownership array. */
+#define FPB_CTRL_ENABLE             (1u << 0)
+#define FPB_CTRL_KEY                (1u << 1)
+#define FPB_CTRL_NUM_CODE           (8u << 4)
+#define FPB_CTRL_REV                0x10000000u
+#define FPB_COMP_REPLACE_MASK       0xc0000000u
+#define FPB_COMP_REPLACE_LOWER      0x40000000u
+#define FPB_COMP_REPLACE_UPPER      0x80000000u
+#define FPB_COMP_REPLACE_BOTH       0xc0000000u
+#define FPB_COMP_ADDRESS_MASK       0x1ffffffcu
+#define FPB_REMAP_RMPSPT            (1u << 29)
+#define FPB_REMAP_ADDR_MASK         0x1fffffe0u
+#define DEMCR_MON_EN                (1u << 16)
+#define DEMCR_MON_STEP              (1u << 18)
+#define DEMCR_MON_PEND              (1u << 17)
+#define DEMCR_SDME                  (1u << 20)
+
+static bool nvic_fpb_access_ok(NVICState *s, MemTxAttrs attrs)
+{
+    /* FPB is privileged. On v8-M, SDME selects the Secure debug domain;
+     * an NS access to the secure-only view is RAZ/WI. */
+    if (attrs.user) {
+        return false;
+    }
+    if (arm_feature(&s->cpu->env, ARM_FEATURE_M_SECURITY) &&
+        !attrs.secure && (s->demcr & DEMCR_SDME)) {
+        return false;
+    }
+    return true;
+}
+
+static bool nvic_fpb_is_remap(NVICState *s, uint32_t comp)
+{
+    /* FPBv2 REPLACE=00 uses the remap table. A zero remap base is treated
+     * as the legacy debugger encoding used by existing profiles. */
+    return (comp & FPB_COMP_REPLACE_MASK) == 0 &&
+           s->fpb_remap_valid;
+}
+
+static bool nvic_fpb_is_breakpoint(NVICState *s, uint32_t comp)
+{
+    uint32_t replace = comp & FPB_COMP_REPLACE_MASK;
+    return (comp & 1) && (replace != 0 || s->fpb_remap == 0);
+}
+
+static vaddr nvic_fpb_address(uint32_t comp)
+{
+    return comp & FPB_COMP_ADDRESS_MASK;
+}
+
+static void nvic_fpb_clear_breakpoints(NVICState *s)
+{
+    unsigned i;
+    if (!s->cpu) {
+        return;
+    }
+    for (i = 0; i < ARRAY_SIZE(s->fpb_breakpoint); ++i) {
+        if (s->fpb_breakpoint[i]) {
+            cpu_breakpoint_remove_by_ref(CPU(s->cpu), s->fpb_breakpoint[i]);
+            s->fpb_breakpoint[i] = NULL;
+        }
+    }
+}
+
+static void nvic_fpb_update(NVICState *s)
+{
+    unsigned i;
+
+    nvic_fpb_clear_breakpoints(s);
+    if (!(s->fpb_ctrl & FPB_CTRL_ENABLE)) {
+        return;
+    }
+    for (i = 0; i < ARRAY_SIZE(s->fpb_comp); ++i) {
+        if (nvic_fpb_is_breakpoint(s, s->fpb_comp[i]) ||
+            nvic_fpb_is_remap(s, s->fpb_comp[i])) {
+            cpu_breakpoint_insert(CPU(s->cpu), nvic_fpb_address(s->fpb_comp[i]),
+                                  BP_CPU, &s->fpb_breakpoint[i]);
+        }
+    }
+}
+
+bool armv7m_nvic_fpb_debugmon_enabled(NVICState *s)
+{
+    return (s->demcr & DEMCR_MON_EN) != 0;
+}
+
+bool armv7m_nvic_fpb_match(NVICState *s, vaddr pc, vaddr *remap_pc)
+{
+    unsigned i;
+
+    if (!(s->fpb_ctrl & FPB_CTRL_ENABLE)) {
+        return false;
+    }
+    for (i = 0; i < ARRAY_SIZE(s->fpb_comp); ++i) {
+        uint32_t comp = s->fpb_comp[i];
+        if (!nvic_fpb_is_breakpoint(s, comp) && !nvic_fpb_is_remap(s, comp)) {
+            continue;
+        }
+        if (nvic_fpb_address(comp) != (pc & ~1u)) {
+            continue;
+        }
+        if (nvic_fpb_is_remap(s, comp)) {
+            /* Each comparator owns one word in the remap table. Preserve the
+             * halfword selected by the original PC. */
+            if (remap_pc) {
+                *remap_pc = s->fpb_remap_base + (s->fpb_remap & FPB_REMAP_ADDR_MASK) +
+                           i * 4 + (pc & 2);
+            }
+        }
+        return true;
+    }
+    return false;
+}
+
+static MemTxResult nvic_fpb_read(void *opaque, hwaddr offset, uint64_t *data,
+                                 unsigned size, MemTxAttrs attrs)
+{
+    NVICState *s = opaque;
+    if (!nvic_fpb_access_ok(s, attrs)) {
+        return MEMTX_ERROR;
+    }
+    *data = 0;
+    if (offset == 0) {
+        *data = FPB_CTRL_REV | FPB_CTRL_NUM_CODE |
+                (s->fpb_ctrl & FPB_CTRL_ENABLE);
+    } else if (offset == 4) {
+        *data = (s->fpb_remap & ~0x1fu) | FPB_REMAP_RMPSPT;
+    } else if (offset >= 8 && offset < 40) {
+        *data = s->fpb_comp[(offset - 8) / 4];
+    }
+    return MEMTX_OK;
+}
+
+static MemTxResult nvic_fpb_write(void *opaque, hwaddr offset, uint64_t value,
+                                  unsigned size, MemTxAttrs attrs)
+{
+    NVICState *s = opaque;
+    if (!nvic_fpb_access_ok(s, attrs)) {
+        return MEMTX_ERROR;
+    }
+    if (offset == 0) {
+        /* KEY is required on every FP_CTRL write; it is never stored. */
+        if (value & FPB_CTRL_KEY) {
+            s->fpb_ctrl = value & FPB_CTRL_ENABLE;
+            nvic_fpb_update(s);
+        }
+    } else if (offset == 4) {
+        s->fpb_remap = value & FPB_REMAP_ADDR_MASK;
+        s->fpb_remap_valid = true;
+    } else if (offset >= 8 && offset < 40) {
+        s->fpb_comp[(offset - 8) / 4] = value &
+            (FPB_COMP_REPLACE_MASK | FPB_COMP_ADDRESS_MASK | 1u);
+        nvic_fpb_update(s);
+    }
+    return MEMTX_OK;
+}
+
+static const MemoryRegionOps nvic_fpb_ops = {
+    .read_with_attrs = nvic_fpb_read,
+    .write_with_attrs = nvic_fpb_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4, .unaligned = false },
+};
 
