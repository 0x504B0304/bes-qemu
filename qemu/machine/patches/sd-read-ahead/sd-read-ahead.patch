+/* The key is the real backend offset, including the eMMC partition. */
+static bool sd_read_ahead(SDState *sd, uint64_t addr, uint32_t len)
+{
+    uint64_t base;
+    uint32_t count;
+    int64_t length;
+
+    if (!sd->read_ahead_bytes || !sd->blk ||
+        len > sd->read_ahead_bytes) {
+        return false;
+    }
+    if (addr >= sd->read_ahead_base &&
+        addr - sd->read_ahead_base <= sd->read_ahead_valid &&
+        len <= sd->read_ahead_valid - (addr - sd->read_ahead_base)) {
+        memcpy(sd->data, sd->read_ahead_data +
+               (addr - sd->read_ahead_base), len);
+        return true;
+    }
+
+    sd->read_ahead_valid = 0;
+    base = addr & ~((uint64_t)sd->read_ahead_bytes - 1);
+    length = blk_getlength(sd->blk);
+    if (length < 0 || base >= length) {
+        return false;
+    }
+    count = MIN((uint64_t)sd->read_ahead_bytes, length - base);
+    if (addr - base > count || len > count - (addr - base) ||
+        blk_pread(sd->blk, base, count, sd->read_ahead_data, 0) < 0) {
+        /* Speculative I/O must not change the original request's error. */
+        return false;
+    }
+    sd->read_ahead_base = base;
+    sd->read_ahead_valid = count;
+    memcpy(sd->data, sd->read_ahead_data + (addr - base), len);
+    return true;
