+/* QEMU has coherent guest RAM and does not implement a separate cache.
+ * These privileged word writes have no stateful effect, so TCG may complete
+ * them without serializing unrelated AMP cores through the global I/O lock.
+ * Unprivileged accesses still take the original BusFault path.
+ */
+static bool nvic_cache_write_is_nop(void *opaque, hwaddr addr, uint64_t value,
+                                   unsigned size, MemTxAttrs attrs)
+{
+    if (attrs.user || size != 4) {
+        return false;
+    }
+    switch (addr) {
+    case 0xf50: /* ICIALLU */
+    case 0xf58: /* ICIMVAU */
+    case 0xf5c: /* DCIMVAC */
+    case 0xf60: /* DCISW */
+    case 0xf64: /* DCCMVAU */
+    case 0xf68: /* DCCMVAC */
+    case 0xf6c: /* DCCSW */
+    case 0xf70: /* DCCIMVAC */
+    case 0xf74: /* DCCISW */
+    case 0xf78: /* BPIALL */
+        trace_nvic_sysreg_write(addr, value, size);
+        return true;
+    default:
+        return false;
+    }
+}
+
 static const MemoryRegionOps nvic_sysreg_ops = {
     .read_with_attrs = nvic_sysreg_read,
     .write_with_attrs = nvic_sysreg_write,
+    .write_is_nop = nvic_cache_write_is_nop,
     .endianness = DEVICE_NATIVE_ENDIAN,
 };
 
