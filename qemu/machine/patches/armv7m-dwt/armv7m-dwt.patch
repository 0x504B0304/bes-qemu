+
+static MemTxResult dwt_read(void *opaque, hwaddr addr,
+                            uint64_t *data, unsigned size,
+                            MemTxAttrs attrs)
+{
+    ARMv7MState *s = opaque;
+
+    switch (addr) {
+    case 0x000:
+        *data = s->dwt_ctrl;
+        return MEMTX_OK;
+    case 0x004:
+        /* CYCCNT is used for timeout accounting by the firmware. A
+         * per-read increment preserves forward progress without making
+         * the hot path depend on host wall-clock locks. */
+        if (s->dwt_ctrl & 1) {
+            s->dwt_cyccnt++;
+        }
+        *data = s->dwt_cyccnt;
+        return MEMTX_OK;
+    default:
+        *data = 0;
+        return MEMTX_ERROR;
+    }
+}
+
+static MemTxResult dwt_write(void *opaque, hwaddr addr, uint64_t value,
+                             unsigned size, MemTxAttrs attrs)
+{
+    ARMv7MState *s = opaque;
+
+    switch (addr) {
+    case 0x000:
+        s->dwt_ctrl = value;
+        return MEMTX_OK;
+    case 0x004:
+        s->dwt_cyccnt = value;
+        return MEMTX_OK;
+    default:
+        return MEMTX_ERROR;
+    }
+}
+
+static const MemoryRegionOps dwt_ops = {
+    .read_with_attrs = dwt_read,
+    .write_with_attrs = dwt_write,
+    .endianness = DEVICE_NATIVE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static void armv7m_dwt_reset(void *opaque)
+{
+    ARMv7MState *s = opaque;
+
+    s->dwt_ctrl = 0;
+    s->dwt_cyccnt = 0;
+}
 
